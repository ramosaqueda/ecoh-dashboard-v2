# .npmrc - Configuración NPM para ECOH Dashboard
# Política de versiones estables

# Guardar versiones exactas en package.json
# Esto evita actualizaciones accidentales de major/minor versions
save-exact=false
save-prefix=~

# Solo actualizar patches automáticamente
# ~1.2.3 permite 1.2.x pero no 1.3.x
# ^1.2.3 permitiría 1.x.x (más peligroso)

# No actualizar automáticamente package-lock.json
package-lock=true

# Resolver conflictos de peer dependencies (útil con React 18)
legacy-peer-deps=false
strict-peer-dependencies=false

# Configuración de instalación
audit=true
fund=false

# Logging
loglevel=warn

# ================================================
# IMPORTANTE: Para instalar con compatibilidad
# ================================================
# Si tienes problemas de peer dependencies, ejecuta:
#   npm install --legacy-peer-deps
# 
# O temporalmente cambia legacy-peer-deps=true arriba
# ================================================

# ================================================
# POLÍTICA DE VERSIONES
# ================================================
# React: Mantener en 18.2.0 hasta Q3 2026
# date-fns: Mantener en 3.x por compatibilidad
# react-leaflet: Mantener en 4.x por React 18
# Prisma: Mantener versiones sincronizadas
# ================================================
